# Copy to backend/.env for local runs — never commit .env (see backend/SECRETS.md).
# Same keys are used by Netlify (sriniai.netlify.app) and Render.
GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=openai/gpt-oss-20b
# ADPLIST_MENTOR_SLUG=srini-chakkarapani

# Langfuse observability (optional — tracing is disabled when unset)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_HOST=https://us.cloud.langfuse.com
# LANGFUSE_ENVIRONMENT=development
# LANGFUSE_RELEASE=1.0.0
# LANGFUSE_SAMPLE_RATE=1
